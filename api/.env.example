# FoodMitra PHP API — copy to .env and fill values
# Never commit real secrets.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=foodmitra
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

RAZORPAY_KEY_ID=rzp_test_XXXXXXXX
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# SHA-256 hex of the plain API key (from: php bin/generate-api-key.php)
# Also insert the same hash into api_keys table.
API_KEY_HASH=
# Optional pepper mixed into the hash (must match when regenerating)
API_KEY_PEPPER=

CORS_ORIGIN=*
CURRENCY=INR

# Global API rate limit per IP / API key (requests per minute)
RATE_LIMIT_PER_MINUTE=60

# OTP
OTP_TTL_SECONDS=300
OTP_RATE_LIMIT_PER_HOUR=5
OTP_LENGTH=6

# Fast2SMS — https://www.fast2sms.com
FAST2SMS_API_KEY=YOUR_FAST2SMS_API_KEY
FAST2SMS_ROUTE=otp
FAST2SMS_SENDER_ID=FSTSMS
# DLT template / message id when required by Fast2SMS account
FAST2SMS_TEMPLATE_ID=

# OSRM + realtime
OSRM_BASE_URL=https://router.project-osrm.org
REALTIME_EMIT_URL=http://127.0.0.1:3101/emit
REALTIME_SECRET=foodmitra_realtime

# Optional — Expo push access token for delivery job alerts
# https://expo.dev → Access tokens (improves push delivery reliability)
EXPO_ACCESS_TOKEN=
